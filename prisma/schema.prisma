// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Stock {
  id            Int       @id @default(autoincrement())
  symbol        String
  name          String?
  price         Float?
  changePercent Float?    @map("change_percent")
  volume        String?
  marketCap     String?   @map("market_cap")
  market        String?
  createdAt     DateTime? @default(now()) @map("created_at")

  @@map("stocks")
}

model StockPrice {
  id            Int      @id @default(autoincrement())
  timestamp     String
  symbol        String
  name          String?
  price         Float?
  changePercent Float?   @map("change_percent")
  volume        String?
  marketCap     String?  @map("market_cap")
  market        String?

  @@unique([timestamp, symbol])
  @@map("stock_prices")
}

model HistoricalData {
  id         Int     @id @default(autoincrement())
  symbol     String
  name       String?
  market     String?
  date       String
  open       Float?
  high       Float?
  low        Float?
  close      Float?
  volume     Int?
  lastFetch  String? @map("last_fetch")

  @@unique([symbol, date])
  @@map("historical_data")
}

model GoldPrice {
  id             Int     @id @default(autoincrement())
  timestamp      String
  country        String
  currency       String
  karat          String
  pricePerGram   Float?  @map("price_per_gram")
  pricePerOunce  Float?  @map("price_per_ounce")

  @@unique([timestamp, country, karat])
  @@map("gold_prices")
}

model SilverPrice {
  id             Int     @id @default(autoincrement())
  timestamp      String
  country        String
  currency       String
  pricePerGram   Float?  @map("price_per_gram")
  pricePerOunce  Float?  @map("price_per_ounce")

  @@unique([timestamp, country])
  @@map("silver_prices")
}

model ExchangeRate {
  id         Int     @id @default(autoincrement())
  timestamp  String
  currency   String
  rateToUsd  Float?  @map("rate_to_usd")

  @@unique([timestamp, currency])
  @@map("exchange_rates")
}

model CryptoPrice {
  id               Int     @id @default(autoincrement())
  timestamp        String
  rank             Int?
  symbol           String
  name             String?
  priceUsd         Float?  @map("price_usd")
  priceChange24h   Float?  @map("price_change_24h")
  priceChange7d    Float?  @map("price_change_7d")
  marketCap        Float?  @map("market_cap")
  marketCapRank    Int?    @map("market_cap_rank")
  totalVolume      Float?  @map("total_volume")
  circulatingSupply Float? @map("circulating_supply")

  @@unique([timestamp, symbol])
  @@map("crypto_prices")
}

model BtcLocalPrice {
  id        Int     @id @default(autoincrement())
  timestamp String
  currency  String
  price     Float?
  change24h Float?  @map("change_24h")

  @@unique([timestamp, currency])
  @@map("btc_local_prices")
}
