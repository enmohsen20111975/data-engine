// Data Engine - Prisma Schema
// مطابق لقاعدة البيانات الفعلية

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/data-factory.db"
}

// =============================================================================
// جدول الأسهم الرئيسي
// =============================================================================
model Stock {
  id            String   @id @default(cuid())
  symbol        String   @unique
  nameAr        String?
  nameEn        String?
  exchange      String
  urlSlug       String?
  sector        String?
  industry      String?
  website       String?
  headquarters  String?
  foundedYear   Int?
  description   String?
  iconUrl       String?
  isin          String?
  country       String?
  createdAt     Int
  updatedAt     Int

  // العلاقات
  overview       StockOverview?
  historicalData HistoricalData[]

  @@index([symbol])
  @@index([exchange])
  @@index([country])
}

// =============================================================================
// نظرة عامة على السهم
// =============================================================================
model StockOverview {
  id               String  @id @default(cuid())
  stockId          String  @unique
  
  currentPrice     Float?
  changeAmount     Float?
  changePercent    Float?
  marketCap        Float?
  enterpriseValue  Float?
  peRatioTTM       Float?
  peRatioFwd       Float?
  epsTTM           Float?
  eps              Float?
  dividendYield    Float?
  dividendRate     Float?
  beta             Float?
  sharesOutstanding Float?
  floatShares      Float?
  avgVolume        Float?
  dayHigh          Float?
  dayLow           Float?
  yearHigh         Float?
  yearLow          Float?
  fiftyDayMA       Float?
  twoHundredDayMA  Float?
  revenueFY        Float?
  netIncomeFY      Float?
  employees        Int?
  createdAt        String
  updatedAt        String

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

// =============================================================================
// البيانات التاريخية اليومية
// =============================================================================
model HistoricalData {
  id            String  @id @default(cuid())
  stockId       String
  date          String
  open          Float?
  high          Float?
  low           Float?
  close         Float?
  adjustedClose Float?
  volume        Float?
  createdAt     String

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, date])
  @@index([stockId, date])
}
